# Optional: leave empty for persistent local SQLite. Required on Vercel.
DATABASE_URL=
# Set the exact public origin on hosted deployments.
APP_URL=http://localhost:3000
# Local SQLite file; never commit it.
SQLITE_PATH=./data/leadflow.sqlite
# Optional outbound email. Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=
# Sample workspace is available locally. Explicitly opt in on hosted deployments.
ENABLE_DEMO=false
# Set true only when the app is behind one trusted proxy that overwrites X-Forwarded-For.
LEADFLOW_TRUST_PROXY=false
